FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "alpha.water.*"
    {
        nAlphaCorr 1;
        nAlphaSubCycles 2;
        cAlpha 1;
    }
    p_rgh
    {
        solver GAMG;
        tolerance 1e-8;
        relTol 0.01;
        smoother DIC;
        cacheAgglomeration no;
    }
    p_rghFinal
    {
        $p_rgh;
        relTol 0;
    }
    "pcorr.*"
    {
        $p_rghFinal;
        tolerance 1e-4;
    }
    U
    {
        solver smoothSolver;
        smoother GaussSeidel;
        tolerance 1e-7;
        relTol 0;
        nSweeps 1;
    }
}
PIMPLE
{
    momentumPredictor no;
    nCorrectors 2;
    nNonOrthogonalCorrectors 0;
    pRefCell 0;
    pRefValue 0;
}
