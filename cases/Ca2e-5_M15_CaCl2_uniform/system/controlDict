FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application interFoam;
startFrom latestTime;
startTime 0;
stopAt endTime;
endTime 15.7150282022;
deltaT 1e-6;
writeControl adjustableRunTime;
writeInterval 0.392875705055;
purgeWrite 0;
writeFormat ascii;
writePrecision 9;
writeCompression off;
timeFormat general;
timePrecision 12;
runTimeModifiable true;
adjustTimeStep yes;
maxCo 0.8;
maxAlphaCo 0.8;
maxDeltaT 0.392875705055;
libs ("libfieldAlphaContactAngle.so");

functions
{
    waterSaturation
    {
        type volFieldValue;
        libs (fieldFunctionObjects);
        writeControl writeTime;
        writeFields false;
        regionType all;
        operation volAverage;
        fields (alpha.water);
    }
}
