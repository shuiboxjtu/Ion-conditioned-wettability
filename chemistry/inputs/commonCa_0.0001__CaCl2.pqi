TITLE Reduced calcite-acidic-oil sensitivity lookup
SURFACE_MASTER_SPECIES
 Cal_s Cal_sOH
 Oil_w Oil_wCOOH
SURFACE_SPECIES
 Cal_sOH = Cal_sOH
  log_k 0
 Cal_sOH + H+ = Cal_sOH2+
  log_k 7.0
 Cal_sOH = Cal_sO- + H+
  log_k -8.5
 Cal_sOH + Na+ = Cal_sONa + H+
  log_k -7.6
 Cal_sOH + Ca+2 = Cal_sOCa+ + H+
  log_k -4.2
 Cal_sOH + Mg+2 = Cal_sOMg+ + H+
  log_k -6.4
 Cal_sOH + SO4-2 = Cal_sSO4- + OH-
  log_k -1.5
 Oil_wCOOH = Oil_wCOOH
  log_k 0
 Oil_wCOOH = Oil_wCOO- + H+
  log_k -5.0
 Oil_wCOOH + Ca+2 = Oil_wCOOCa+ + H+
  log_k -2.0
 Oil_wCOOH + Mg+2 = Oil_wCOOMg+ + H+
  log_k -6.4
SELECTED_OUTPUT 1
 -active true
 -reset false
 -high_precision true
 -solution true
USER_PUNCH 1
 -headings TBP sulfate_fraction charge_pair sodium_product final_pH
 -start
 10 ctot=MOL("Cal_sOH")+MOL("Cal_sOH2+")+MOL("Cal_sO-")+MOL("Cal_sONa")+MOL("Cal_sOCa+")+MOL("Cal_sOMg+")+MOL("Cal_sSO4-")
 20 otot=MOL("Oil_wCOOH")+MOL("Oil_wCOO-")+MOL("Oil_wCOOCa+")+MOL("Oil_wCOOMg+")
 30 cp=(MOL("Cal_sOH2+")+MOL("Cal_sOCa+")+MOL("Cal_sOMg+"))/ctot
 40 cn=(MOL("Cal_sO-")+MOL("Cal_sSO4-"))/ctot
 50 oilneg=MOL("Oil_wCOO-")/otot
 60 oilpos=(MOL("Oil_wCOOCa+")+MOL("Oil_wCOOMg+"))/otot
 70 tbp=0.28*(1-MOL("Cal_sSO4-")/ctot)+oilneg*cp+oilpos*cn+0.50*oilneg*MOL("Cal_sONa")/ctot
 80 PUNCH tbp, MOL("Cal_sSO4-")/ctot, oilneg*cp+oilpos*cn, oilneg*MOL("Cal_sONa")/ctot, -LA("H+")
 -end

SOLUTION 1
 units mol/kgw
 pH 8.5
 Na 0.005
 Ca 0.0001
 Cl 0.0052
SURFACE 1
 Cal_sOH 5e-6 1 1
 Oil_wCOOH 2e-6 1 1
 -equilibrate 1
 -no_edl true
END

